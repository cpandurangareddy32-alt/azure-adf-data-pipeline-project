{
	"name": "pipeline1",
	"properties": {
		"activities": [
			{
				"name": "Load_Nation_Region",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"additionalColumns": [
							{
								"name": "INSERT_DATE",
								"value": {
									"value": "@utcNow()",
									"type": "Expression"
								}
							}
						],
						"sqlReaderQuery": "SELECT\n    n.NATIONKEY,\n    n.NAME AS NAME,\n    n.REGIONKEY,\n    r.NAME AS REGION_NAME\nFROM STG.NATION n\nINNER JOIN STG.REGION r\n    ON n.REGIONKEY = r.REGIONKEY;",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"sink": {
						"type": "AzureSqlSink",
						"preCopyScript": "TRUNCATE TABLE ODS.NATION_REGION_DETAILS;",
						"writeBehavior": "insert",
						"sqlWriterUseTableLock": false,
						"disableMetricsCollection": false
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"mappings": [
							{
								"source": {
									"name": "NATIONKEY",
									"type": "Int32",
									"physicalType": "int"
								},
								"sink": {
									"name": "NATIONKEY",
									"type": "Int32",
									"physicalType": "int"
								}
							},
							{
								"source": {
									"name": "NAME",
									"type": "String",
									"physicalType": "varchar"
								},
								"sink": {
									"name": "NAME",
									"type": "String",
									"physicalType": "varchar"
								}
							},
							{
								"source": {
									"name": "REGIONKEY",
									"type": "Int32",
									"physicalType": "int"
								},
								"sink": {
									"name": "REGIONKEY",
									"type": "Int32",
									"physicalType": "int"
								}
							},
							{
								"source": {
									"name": "REGION_NAME",
									"type": "String",
									"physicalType": "varchar"
								},
								"sink": {
									"name": "REGION_NAME",
									"type": "String",
									"physicalType": "varchar"
								}
							},
							{
								"source": {
									"name": "INSERT_DATE",
									"type": "String"
								},
								"sink": {
									"name": "INSERT_DATE",
									"type": "DateTime",
									"physicalType": "datetime"
								}
							}
						],
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "fake",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "ds_raw_table_cpandu",
						"type": "DatasetReference",
						"parameters": {
							"schema_name": "ODS",
							"table_name": "NATION_REGION_DETAILS"
						}
					}
				]
			}
		],
		"annotations": []
	}
}